# ---------- Database ----------
# Local dev uses SQLite (file created next to where you start the server):
DATABASE_URL=sqlite:///./cafe_companion.db

# Google Cloud SQL (PostgreSQL) — set INSTANCE_CONNECTION_NAME to switch over:
INSTANCE_CONNECTION_NAME=
DB_USER=postgres
DB_PASS=change-me
DB_NAME=cafe_companion
DB_IAM_AUTH=false
DB_IP_TYPE=public
# Or via the Cloud SQL Auth Proxy (leave INSTANCE_CONNECTION_NAME empty):
#   cloud-sql-proxy your-project:asia-south1:cafe-companion-db --port 5432
#   DATABASE_URL=postgresql+pg8000://postgres:change-me@127.0.0.1:5432/cafe_companion

# ---------- Auth ----------
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
JWT_SECRET=generate-a-long-random-string

# ---------- Gemini ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------- App ----------
CORS_ORIGINS=http://localhost:5173
STAFF_PIN=1234
BARISTAS=2
CHECKIN_HOURS=3

# Local testing only: fill the demo cafe room with fake guests
DEMO_GUESTS=false
